<?xml version="1.0"?>
<Container version="2">
  <Name>michamodus-medien</Name>
  <Repository>ghcr.io/flexisticker/michamodus-medien:latest</Repository>
  <Registry>https://github.com/flexisticker/lumia-animationen/pkgs/container/michamodus-medien</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Stellt die MichaModus-Videos, die Musik und die Lumia-Overlay-Dateien bereit. Neue Medien kommen per Docker-Update.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/animationen/rose.mp4</WebUI>
  <Config Name="Port" Target="8080" Default="8099" Mode="tcp" Description="Port im Heimnetz" Type="Port" Display="always" Required="true">8099</Config>
</Container>
