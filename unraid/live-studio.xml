<?xml version="1.0"?>
<Container version="2">
  <Name>live-studio</Name>
  <Repository>ghcr.io/flexisticker/live-studio:latest</Repository>
  <Registry>https://github.com/flexisticker/lumia-animationen/pkgs/container/live-studio</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Live-Studio (MichaModus + 3dbymicha, umschaltbar) – Verwaltung (/studio), Tablet-Steuerung (/aktion) und Browserquellen (/quelle/vorne, /quelle/hinten) für TikTok-Lives mit Lumia Stream.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/studio</WebUI>
  <Icon>http://192.168.1.10:8120/icon.png</Icon>
  <Config Name="Port" Target="8080" Default="8120" Mode="tcp" Description="Port im Heimnetz" Type="Port" Display="always" Required="true">8120</Config>
  <Config Name="Daten" Target="/data" Default="/mnt/user/appdata/live-studio" Mode="rw" Description="Einstellungen und eigene Videos" Type="Path" Display="always" Required="true">/mnt/user/appdata/live-studio</Config>
</Container>
