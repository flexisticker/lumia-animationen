<?xml version="1.0"?>
<Container version="2">
  <Name>3dbymicha-studio</Name>
  <Repository>ghcr.io/flexisticker/live-studio:latest</Repository>
  <Registry>https://github.com/flexisticker/lumia-animationen/pkgs/container/live-studio</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>3dbymicha Studio – Verwaltung (/studio), Tablet-Steuerung (/aktion) und Browserquellen (/quelle/vorne, /quelle/hinten) für TikTok-Lives mit Lumia Stream.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/studio</WebUI>
  <Icon>http://192.168.1.10:8122/icon.png</Icon>
  <Config Name="Port" Target="8080" Default="8122" Mode="tcp" Description="Port im Heimnetz" Type="Port" Display="always" Required="true">8122</Config>
  <Config Name="Daten" Target="/data" Default="/mnt/user/appdata/3dbymicha-studio" Mode="rw" Description="Einstellungen und eigene Videos" Type="Path" Display="always" Required="true">/mnt/user/appdata/3dbymicha-studio</Config>
  <Config Name="Kanal" Target="KANAL" Default="3dbymicha" Mode="" Description="michamodus oder 3dbymicha" Type="Variable" Display="advanced" Required="true">3dbymicha</Config>
</Container>
